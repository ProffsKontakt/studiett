# Kopiera till .env. Denna fil ska ALDRIG committas eller delas.
# Utan dessa värden körs servern på mockdata (server/data/*.json).

# Canvas: canvas.kth.se -> Konto -> Inställningar -> Godkända integrationer -> "+ Ny åtkomsttoken"
CANVAS_BASE_URL=https://canvas.kth.se
CANVAS_TOKEN=

# TimeEdit: kth.se/schema -> Prenumerera -> kopiera länken (slutar på .ics)
TIMEEDIT_ICAL_URL=

# Mockprofil när riktiga kopplingar saknas: viktor (KTH) eller julian (SU/DSV)
STUDENT=viktor

# Port för den lokala servern
PORT=3000

# Ladok saknar API. Tills dess: program, kurser och tentafönster från en handunderhållen
# mockprofil läggs ovanpå de riktiga källorna. Tom = inga Ladok-data alls.
LADOK_MOCK=viktor

# Visas i appen när riktiga kopplingar används
STUDENT_NAME=
INSTITUTION=KTH

# Hur länge Canvas- och TimeEdit-svar cachas i minuter (Canvas har rate limit)
CACHE_TTL_MIN=10
